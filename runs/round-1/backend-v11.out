      SELECT u.id, u.avatar_media_id, u.bio, u.created_at, u.deleted_at, u.display_name, u.email, u.email_verified_at, u.last_login_at, u.password_hash, u.phone, u.role_id, u.status, u.suspended_until, u.updated_at, r.id, r.code, r.name, m.id, m.created_at, m.mime_type, m.size_bytes, m.storage_key, m.uploader_id, m.url
      FROM core.users AS u
      INNER JOIN core.roles AS r ON u.role_id = r.id
