            AND NOT EXISTS (
                SELECT 1
                FROM core.outbox_messages AS earlier
                WHERE earlier.aggregate_key = o.aggregate_key
                  AND earlier.id < o.id
                  AND earlier.status IN ('pending', 'processing'))
          ORDER BY o.id
          LIMIT @p1
          FOR UPDATE SKIP LOCKED)
      RETURNING m.*
