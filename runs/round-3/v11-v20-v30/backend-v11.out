      UPDATE core.roadmap_generation_jobs AS job
      SET status = 'running'
      WHERE job.id = (
          SELECT queued.id
          FROM core.roadmap_generation_jobs AS queued
          WHERE queued.status = 'queued'
          ORDER BY queued.id
          LIMIT 1
          FOR UPDATE SKIP LOCKED)
      RETURNING job.id AS "Value"
