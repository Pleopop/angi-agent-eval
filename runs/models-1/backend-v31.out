      SELECT u.id, u.avatar_media_id, u.bio, u.created_at, u.deleted_at, u.display_name, u.email, u.email_verified_at, u.last_login_at, u.password_hash, u.phone, u.role_id, u.status, u.suspended_until, u.updated_at, r.id, r.code, r.name, m.id, m.created_at, m.mime_type, m.size_bytes, m.storage_key, m.uploader_id, m.url
      FROM core.users AS u
      INNER JOIN core.roles AS r ON u.role_id = r.id
      LEFT JOIN core.media_files AS m ON u.avatar_media_id = m.id
      WHERE u.deleted_at IS NULL AND u.email = @normalizedEmail
      LIMIT 1
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (3ms) [Parameters=[p0='?' (DbType = Int32), p1='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      UPDATE core.outbox_messages AS m
      SET status = 'processing', locked_until = now() + make_interval(secs => @p0)
      WHERE m.id IN (
          SELECT o.id
          FROM core.outbox_messages AS o
          WHERE ((o.status = 'pending' AND o.next_attempt_at <= now())
              OR (o.status = 'processing' AND o.locked_until < now()))
            AND NOT EXISTS (
                SELECT 1
                FROM core.outbox_messages AS earlier
                WHERE earlier.aggregate_key = o.aggregate_key
                  AND earlier.id < o.id
                  AND earlier.status IN ('pending', 'processing'))
          ORDER BY o.id
          LIMIT @p1
          FOR UPDATE SKIP LOCKED)
      RETURNING m.*
