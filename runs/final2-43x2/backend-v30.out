      SELECT s.dish_id, s.tag_id, s.id, s.code, s.name, s.tag_type, d.id, r0.id, m.id
      FROM core.dishes AS d
      INNER JOIN (
          SELECT r.id, r.moderation_status, r.operating_status, r.verification_status
          FROM core.restaurants AS r
          WHERE r.deleted_at IS NULL
      ) AS r0 ON d.restaurant_id = r0.id
      LEFT JOIN core.media_files AS m ON d.cover_media_id = m.id
      INNER JOIN (
          SELECT d0.dish_id, d0.tag_id, t.id, t.code, t.name, t.tag_type
          FROM core.dish_tags AS d0
          INNER JOIN core.tags AS t ON d0.tag_id = t.id
      ) AS s ON d.id = s.dish_id
      WHERE d.status = 'active' AND d.is_available AND r0.verification_status = 'verified' AND r0.moderation_status = 'visible' AND r0.operating_status = 'open' AND d.id = ANY (@ids)
      ORDER BY d.id, r0.id, m.id
