      SELECT a.id, a.created_at, a.current_proposal_id, a.expires_at, a.last_message_sequence, a.last_proposal_version, a.processing_attempt_id, a.processing_turn_id, a.processing_until, a.purged_client_message_id, a.roadmap_id, a.state, a.status, a.updated_at, a.user_id, a.version
      FROM core.agent_conversations AS a
