      INSERT INTO core.agent_conversations (created_at, current_proposal_id, expires_at, last_message_sequence, last_proposal_version, processing_attempt_id, processing_turn_id, processing_until, purged_client_message_id, roadmap_id, state, status, updated_at, user_id, version)
      VALUES (@p0, @p1, @p2, @p3, @p4, @p5, @p6, @p7, @p8, @p9, @p10, @p11, @p12, @p13, @p14)
