      Executed DbCommand (3ms) [Parameters=[p0='?' (DbType = Int32), p1='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      UPDATE core.outbox_messages AS m
      SET status = 'processing', locked_until = now() + make_interval(secs => @p0)
      WHERE m.id IN (
          SELECT o.id
          FROM core.outbox_messages AS o
          WHERE ((o.status = 'pending' AND o.next_attempt_at <= now())
              OR (o.status = 'processing' AND o.locked_until < now()))
            AND NOT EXISTS (
                SELECT 1
                FROM core.outbox_messages AS earlier
                WHERE earlier.aggregate_key = o.aggregate_key
                  AND earlier.id < o.id
                  AND earlier.status IN ('pending', 'processing'))
          ORDER BY o.id
          LIMIT @p1
          FOR UPDATE SKIP LOCKED)
      RETURNING m.*
