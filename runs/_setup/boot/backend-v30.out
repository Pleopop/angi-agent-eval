      ALTER TABLE core.tags ADD CONSTRAINT ck_tags_tag_type CHECK (tag_type IN ('meal_time', 'dietary', 'category', 'meal_role', 'cooking_method', 'ingredient'));
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1,268ms) [Parameters=[], CommandType='Text', CommandTimeout='30']
      DO $$
      BEGIN
          IF NOT EXISTS (SELECT 1 FROM core.tags WHERE tag_type = 'category' AND code = 'local_sf_main') THEN
              RETURN;
          END IF;
      
          UPDATE core.tags SET tag_type = 'ingredient' WHERE tag_type = 'dietary' AND code IN ('pork', 'beef', 'seafood');
      
          UPDATE core.tags AS t SET name = v.name
          FROM (VALUES
              ('meal_time', 'breakfast', 'An s†ng'),
              ('meal_time', 'lunch', 'An trua'),
              ('meal_time', 'snack', 'An v?t'),
              ('meal_time', 'dinner', 'An t?i'),
              ('meal_time', 'late_night', 'An dàm'),
              ('dietary', 'vegetarian', 'M¢n chay'),
              ('category', 'local_sf_dessert', 'Tr†ng mi?ng'),
              ('category', 'local_sf_drink', 'D? u?ng'),
              ('category', 'local_sf_snack', 'D? an v?t'),
              ('ingredient', 'beef', 'Th?t bï'),
              ('ingredient', 'pork', 'Th?t heo'),
              ('ingredient', 'seafood', 'H?i s?n')
          ) AS v(tag_type, code, name)
          WHERE t.tag_type = v.tag_type AND t.code = v.code;
      
          -- Catalogues loaded with explicit ids leave the identity sequence behind.
          PERFORM setval(pg_get_serial_sequence('core.tags', 'id'), GREATEST((SELECT COALESCE(MAX(id), 0) FROM core.tags), 1));
      
          INSERT INTO core.tags (tag_type, code, name) VALUES
              ('dietary', 'diet.thuan_chay', 'Thu?n chay'),
              ('category', 'form.mon_com_va_ngu_coc', 'Com & xìi'),
              ('category', 'form.mon_soi', 'B£n, ph? & mç'),
              ('category', 'form.banh_mi_va_banh_kep', 'B†nh mç & b†nh k?p'),
              ('category', 'form.canh_va_sup', 'Canh & s£p'),
              ('category', 'form.lau', 'L?u'),
              ('category', 'form.chao', 'Ch†o'),
              ('category', 'form.banh_bot_va_mon_nhan', 'B†nh & m¢n b?t'),
              ('category', 'form.goi_va_salad', 'G?i & salad'),
              ('category', 'form.do_an_kem_va_thanh_phan_ban_rieng', 'D? an käm'),
              ('category', 'form.muc_menu_nhieu_cau_phan', 'Combo & set'),
              ('category', 'form.khac_cho_duyet', 'Kh†c'),
              ('meal_role', 'role.mon_chinh', 'M¢n ch°nh'),
              ('meal_role', 'role.bua_du_trong_mot_mon', 'D? m?t b?a'),
              ('meal_role', 'role.mon_dam_dung_voi_mon_khac', 'M¢n d?m an käm'),
              ('meal_role', 'role.mon_rau_an_kem', 'Rau an käm'),
              ('meal_role', 'role.mon_tinh_bot_an_kem', 'Tinh b?t an käm'),
              ('meal_role', 'role.mon_canh_sup_an_kem', 'Canh an käm'),
              ('meal_role', 'role.khai_vi', 'Khai v?'),
              ('meal_role', 'role.an_vat', 'M¢n an v?t'),
              ('meal_role', 'role.trang_mieng', 'Tr†ng mi?ng'),
              ('meal_role', 'role.do_uong', 'D? u?ng'),
              ('cooking_method', 'method.chien_chua_ro_kieu', 'Chiàn/r†n'),
              ('cooking_method', 'method.nuong', 'Nu?ng'),
              ('cooking_method', 'method.xao', 'XÖo'),
              ('cooking_method', 'method.hap', 'H?p'),
              ('cooking_method', 'method.luoc', 'Lu?c'),
              ('cooking_method', 'method.kho', 'Kho'),
              ('cooking_method', 'method.ham_va_ninh', 'H?m/ninh'),
              ('cooking_method', 'method.tron', 'Tr?n'),
              ('cooking_method', 'method.ap_chao', 'Ap ch?o'),
              ('ingredient', 'ingredient.thit_ga', 'Th?t gÖ'),
              ('ingredient', 'ingredient.thit_vit', 'Th?t v?t'),
              ('ingredient', 'ingredient.trung', 'Tr?ng'),
              ('ingredient', 'ingredient.sua_dong_vat', 'S?a vÖ s?n ph?m s?a'),
              ('ingredient', 'ingredient.dau_phu', 'D?u ph?'),
              ('ingredient', 'ingredient.dau_nanh', 'D?u nÖnh')
          ON CONFLICT (tag_type, code) DO NOTHING;
      
          -- A legacy category tag brings its meal role along, as the owner form does for new dishes.
          INSERT INTO core.dish_tags (dish_id, tag_id)
          SELECT dt.dish_id, r.id
          FROM core.dish_tags dt
          JOIN core.tags s ON s.id = dt.tag_id AND s.tag_type = 'category'
          JOIN (VALUES
              ('local_sf_main', 'role.mon_chinh'),
              ('local_sf_drink', 'role.do_uong'),
              ('local_sf_dessert', 'role.trang_mieng'),
              ('local_sf_snack', 'role.an_vat')
          ) AS m(src, dst) ON m.src = s.code
          JOIN core.tags r ON r.tag_type = 'meal_role' AND r.code = m.dst
          ON CONFLICT (dish_id, tag_id) DO NOTHING;
      END $$;
