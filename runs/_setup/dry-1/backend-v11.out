      UPDATE core.roadmap_generation_jobs AS job
      SET status = 'running'
      WHERE job.id = (
          SELECT queued.id
          FROM core.roadmap_generation_jobs AS queued
          WHERE queued.status = 'queued'
          ORDER BY queued.id
          LIMIT 1
          FOR UPDATE SKIP LOCKED)
      RETURNING job.id AS "Value"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (35ms) [Parameters=[p0='?' (DbType = Int32), p1='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      UPDATE core.outbox_messages AS m
      SET status = 'processing', locked_until = now() + make_interval(secs => @p0)
      WHERE m.id IN (
          SELECT o.id
          FROM core.outbox_messages AS o
          WHERE ((o.status = 'pending' AND o.next_attempt_at <= now())
              OR (o.status = 'processing' AND o.locked_until < now()))
            AND NOT EXISTS (
                SELECT 1
                FROM core.outbox_messages AS earlier
                WHERE earlier.aggregate_key = o.aggregate_key
                  AND earlier.id < o.id
                  AND earlier.status IN ('pending', 'processing'))
          ORDER BY o.id
          LIMIT @p1
          FOR UPDATE SKIP LOCKED)
      RETURNING m.*
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (27ms) [Parameters=[p0='?' (DbType = DateTime), p1='?' (DbType = DateTime), p2='?' (DbType = DateTime), p3='?' (DbType = DateTime), p4='?' (DbType = DateTime), p5='?' (DbType = DateTime), p6='?' (DbType = DateTime), p7='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT * FROM core.agent_conversations
      WHERE (processing_until IS NULL OR processing_until <= @p0)
        AND ((status = 'active' AND expires_at <= @p1)
          OR (status <> 'active' AND updated_at <= @p2 AND
              (roadmap_id IS NULL OR state <> jsonb_build_object() OR current_proposal_id IS NOT NULL))
          OR EXISTS (SELECT 1 FROM core.agent_messages m WHERE m.conversation_id = agent_conversations.id AND m.created_at < @p3
              AND NOT EXISTS (SELECT 1 FROM core.agent_messages u
                  CROSS JOIN LATERAL jsonb_array_elements_text(COALESCE(NULLIF(u.payload->'attempts', 'null'::jsonb), '[]'::jsonb)) a(value)
                  WHERE u.conversation_id = m.conversation_id AND u.turn_id = m.turn_id AND a.value::timestamptz >= @p4))
          OR EXISTS (SELECT 1 FROM core.agent_proposals p WHERE p.conversation_id = agent_conversations.id
              AND p.created_at < @p5 AND p.id IS DISTINCT FROM current_proposal_id
              AND NOT EXISTS (SELECT 1 FROM core.agent_messages m WHERE m.conversation_id = p.conversation_id
                  AND m.response_payload->'proposal'->>'proposalId' = CAST(p.id AS text)
                  AND (m.created_at >= @p6 OR EXISTS (
                      SELECT 1 FROM jsonb_array_elements_text(COALESCE(NULLIF(m.payload->'attempts', 'null'::jsonb), '[]'::jsonb)) a(value)
                      WHERE a.value::timestamptz >= @p7)))))
      ORDER BY updated_at, id LIMIT 100 FOR UPDATE SKIP LOCKED
