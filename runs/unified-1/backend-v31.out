      SELECT s.dish_id, s.tag_id, s.id, s.code, s.name, s.tag_type, d.id, r0.id, m.id
      FROM core.dishes AS d
      INNER JOIN (
          SELECT r.id, r.moderation_status, r.operating_status, r.verification_status
          FROM core.restaurants AS r
          WHERE r.deleted_at IS NULL
