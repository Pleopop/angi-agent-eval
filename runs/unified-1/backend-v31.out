      Executed DbCommand (6ms) [Parameters=[@ToUpper='?', @provincePattern='?', @pattern='?', @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT d0.id::bigint, d0.name, d0.restaurant_id, r1.name, r1.province_name, r1.address_line, d0.status = 'active' AND d0.is_available AND r1.operating_status = 'open'
      FROM (
          SELECT d.id, d.is_available, d.name, d.restaurant_id, d.status, upper(d.name) = @ToUpper AS c
          FROM core.dishes AS d
          WHERE d.restaurant_id IN (
              SELECT r.id
              FROM core.restaurants AS r
              WHERE r.deleted_at IS NULL AND r.verification_status = 'verified' AND r.moderation_status = 'visible' AND r.province_name IS NOT NULL AND r.province_name ILIKE @provincePattern ESCAPE '\'
          ) AND d.status <> 'hidden' AND d.status <> 'removed' AND d.name ILIKE @pattern ESCAPE '\'
          ORDER BY upper(d.name) = @ToUpper DESC, d.id
          LIMIT @p
      ) AS d0
      INNER JOIN (
          SELECT r0.id, r0.address_line, r0.name, r0.operating_status, r0.province_name
          FROM core.restaurants AS r0
          WHERE r0.deleted_at IS NULL
      ) AS r1 ON d0.restaurant_id = r1.id
      ORDER BY d0.c DESC, d0.id
