      SELECT d.id
      FROM core.dishes AS d
      INNER JOIN (
          SELECT r.id, r.moderation_status, r.operating_status, r.province_name, r.rating_avg, r.verification_status
          FROM core.restaurants AS r
          WHERE r.deleted_at IS NULL
      ) AS r0 ON d.restaurant_id = r0.id
      WHERE d.status = 'active' AND d.is_available AND r0.verification_status = 'verified' AND r0.moderation_status = 'visible' AND r0.operating_status = 'open' AND r0.province_name IS NOT NULL AND r0.province_name ILIKE @term ESCAPE '\' AND (NOT EXISTS (
          SELECT 1
          FROM core.dish_tags AS d0
          INNER JOIN core.tags AS t ON d0.tag_id = t.id
          WHERE d.id = d0.dish_id AND t.tag_type = 'meal_time') OR EXISTS (
          SELECT 1
          FROM core.dish_tags AS d1
          INNER JOIN core.tags AS t0 ON d1.tag_id = t0.id
          WHERE d.id = d1.dish_id AND t0.tag_type = 'meal_time' AND t0.code = @code)) AND EXISTS (
          SELECT 1
          FROM core.dish_tags AS d2
          WHERE d.id = d2.dish_id AND d2.tag_id = ANY (@ids))
      ORDER BY r0.rating_avg DESC, d.like_count DESC, d.id
      LIMIT @p
