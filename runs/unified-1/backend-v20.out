      Executed DbCommand (3ms) [Parameters=[p0='?' (DbType = Int32), p1='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      UPDATE core.outbox_messages AS m
      SET status = 'processing', locked_until = now() + make_interval(secs => @p0)
      WHERE m.id IN (
          SELECT o.id
          FROM core.outbox_messages AS o
          WHERE ((o.status = 'pending' AND o.next_attempt_at <= now())
              OR (o.status = 'processing' AND o.locked_until < now()))
            AND NOT EXISTS (
                SELECT 1
                FROM core.outbox_messages AS earlier
                WHERE earlier.aggregate_key = o.aggregate_key
                  AND earlier.id < o.id
                  AND earlier.status IN ('pending', 'processing'))
          ORDER BY o.id
          LIMIT @p1
          FOR UPDATE SKIP LOCKED)
      RETURNING m.*
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (2ms) [Parameters=[p0='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT a.id, a.avatar_media_id, a.bio, a.created_at, a.deleted_at, a.display_name, a.email, a.email_verified_at, a.last_login_at, a.password_hash, a.phone, a.role_id, a.status, a.suspended_until, a.updated_at
      FROM (
          SELECT * FROM core.users WHERE status = 'suspended' AND suspended_until <= @p0 AND deleted_at IS NULL ORDER BY id LIMIT 100 FOR UPDATE SKIP LOCKED
      ) AS a
      WHERE a.deleted_at IS NULL
