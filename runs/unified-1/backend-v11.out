              FROM core.restaurants AS r
              WHERE r.deleted_at IS NULL AND r.verification_status = 'verified' AND r.moderation_status = 'visible'
          ) AND d.status <> 'hidden' AND d.status <> 'removed' AND d.name ILIKE @pattern ESCAPE '\'
          ORDER BY upper(d.name) = @ToUpper DESC, d.id
