      WHERE r.deleted_at IS NULL AND r.verification_status = 'verified' AND r.moderation_status = 'visible' AND r.province_name IS NOT NULL AND r.province_name ILIKE @provincePattern ESCAPE '\' AND r.name ILIKE @pattern ESCAPE '\'
