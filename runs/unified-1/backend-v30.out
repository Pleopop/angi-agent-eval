      Executed DbCommand (5ms) [Parameters=[p0='?' (DbType = Int32), p1='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT s."Value"
      FROM (
          SELECT count(*)::integer AS "Value"
          FROM core.agent_messages m JOIN core.agent_conversations c ON c.id = m.conversation_id
          CROSS JOIN LATERAL jsonb_array_elements_text(m.payload->'attempts') a(value)
          WHERE c.user_id = @p0 AND m.role = 'user' AND a.value::timestamptz >= @p1
      ) AS s
      LIMIT 2
