      SELECT d1.name, d1.description, d1.price, d1.restaurant_id, d1.id, s.name, s.dish_id, s.tag_id, s.id
      FROM (
          SELECT d.name, d.description, d.price, d.restaurant_id, d.id
          FROM core.dishes AS d
          WHERE d.restaurant_id IN (
              SELECT r.id
              FROM core.restaurants AS r
              WHERE r.deleted_at IS NULL AND r.verification_status = 'verified' AND r.moderation_status = 'visible' AND r.operating_status = 'open' AND r.province_name IS NOT NULL AND r.province_name ILIKE @provincePattern ESCAPE '\'
          ) AND d.status = 'active' AND d.is_available
          ORDER BY d.id
          LIMIT @p
      ) AS d1
      LEFT JOIN (
          SELECT t.name, d0.dish_id, d0.tag_id, t.id
          FROM core.dish_tags AS d0
          INNER JOIN core.tags AS t ON d0.tag_id = t.id
      ) AS s ON d1.id = s.dish_id
      ORDER BY d1.id, s.dish_id, s.tag_id
