          INNER JOIN core.tags AS t ON d0.tag_id = t.id
      ) AS s ON d.id = s.dish_id
      WHERE d.status = 'active' AND d.is_available AND r0.verification_status = 'verified' AND r0.moderation_status = 'visible' AND r0.operating_status = 'open' AND d.id = ANY (@ids)
      ORDER BY d.id, r0.id, m.id
